# Local development settings. Copy to backend/.env and fill in. Never commit .env.
# (Production on a server uses the root .env + docker-compose.yml instead - see docs/DEPLOYMENT.md.)

# development | test | production   (production refuses unsafe settings at startup)
APP_ENV=development

# --- LLM ---
# Leave empty to run in offline (rule-based) mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- Database ---
# SQLite for local work; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://smecopilot:password@localhost:5432/smecopilot
DATABASE_URL=sqlite:///./data/smecopilot.db
# Empty -> in-memory rate limiting (fine for a single dev process)
REDIS_URL=

# --- Security ---
# At least 32 characters. Empty in development -> random key per start (everyone gets signed out on restart).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# --- URLs ---
# Used in emailed links (password reset, invites)
PUBLIC_BASE_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:5500

# --- Email ---
# Empty SMTP_HOST -> emails (with their links) are printed to the backend log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SME Finance Copilot <no-reply@localhost>

# --- Operations ---
LOG_LEVEL=INFO
SENTRY_DSN=
MAX_UPLOAD_MB=5

# --- OCR for scanned PDF statements (optional locally; built into the Docker image) ---
# Install Tesseract to try it on Windows: https://github.com/UB-Mannheim/tesseract/wiki
# then point TESSERACT_CMD at it. Without it, scanned PDFs get a clear "OCR not enabled" message.
OCR_ENABLED=true
TESSERACT_CMD=tesseract
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANGUAGES=eng
# Minimum cash cushion in weeks of average operating outflows
SAFETY_BUFFER_WEEKS=1.0
# Indicative exchange rates for financing (units per 1 USD), merged over the built-in table in app/fx.py
# FX_RATES={"BDT": 122}
