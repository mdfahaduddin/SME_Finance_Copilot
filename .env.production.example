# Copy to .env (next to docker-compose.yml) on the server and fill in. Never commit .env.

# Public domain name; its DNS A/AAAA record must point at this server.
# Use DOMAIN=localhost for a local trial (self-signed certificate).
DOMAIN=finance.example.com

# Generate with:  openssl rand -hex 32   (hex: safe inside the database URL)
POSTGRES_PASSWORD=
# Generate with:  openssl rand -base64 48
SECRET_KEY=

# Optional: leave empty to run the copilot in offline (rule-based) mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Email for password resets and team invites. Without SMTP_HOST, emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SME Finance Copilot <no-reply@finance.example.com>

# Optional error tracking
SENTRY_DSN=

# API worker processes (roughly 1 per CPU core, 2 minimum)
WEB_CONCURRENCY=2

# Scanned PDF statements are read with Tesseract OCR on this server (English built in).
# For other scripts on statements, add language packs at build time and enable them, e.g.:
# OCR_LANGS=ben
# OCR_LANGUAGES=eng+ben
LOG_LEVEL=INFO
# Indicative exchange rates for financing (units per 1 USD); empty uses the built-in table
# FX_RATES={"BDT": 122}
